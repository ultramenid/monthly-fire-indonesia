# Copy to .env and adjust. VITE_* values reach the browser, so they are public: never put secrets in them.
# Dev: Vite reads them from here. Production: the server's .env, served as /config.js when the container starts
# (change a value → restart the container, no rebuild).

# Fogo-ID data API (stats, territories, Earth Engine tile URLs). API docs link = $VITE_API_URL/docs/
VITE_API_URL=https://fogo-id.geodatin.com/api
# "MapBiomas Fire" link in the header
VITE_MAPBIOMAS_URL=https://fire.mapbiomas.id/en
# Basemaps: MapLibre style JSON for dark/light, XYZ raster template for satellite
VITE_BASEMAP_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_BASEMAP_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_BASEMAP_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Production (docker compose): public domain, HTTPS certificate is issued automatically by Caddy.
# Use "localhost" to try it locally. Several domains: DOMAIN="fire.example.com, www.fire.example.com"
DOMAIN=fire.example.com
